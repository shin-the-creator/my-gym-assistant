{
  "expo": {
    "name": "My Gym Trainer",
    "slug": "my-gym-assistant",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mygymtrainer",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.mygymassistant.trainer",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "운동기구 사진을 찍어 장소에 있는 기구를 인식하는 데 사용해요.",
          "photosPermission": "앨범의 운동기구 사진을 불러오는 데 사용해요."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#121214",
    "platforms": [
      "android",
      "web"
    ]
  }
}
